# Copy to .env and fill in. .env is gitignored.

# Hugging Face download token. Reaches engine containers only.
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The one bearer key llama-swap accepts. No spaces.
# Generate: printf "sk-%s\n" "$(head -c 48 /dev/urandom | base64 | tr -d '/+=')"
LLAMA_SWAP_API_KEY=sk-change-me

# Host directory holding the HF and vLLM caches (huggingface/ and vllm/ under it).
# llama.cpp GGUF downloads land in huggingface/ too.
# Must be an absolute host path: the host daemon resolves engine bind mounts.
HOST_CACHE_DIR=/home/you/.cache
